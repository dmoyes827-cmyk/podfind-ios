1. name: Deploy to TestFlight
2. 
3. on:
4.   push:
5.     branches: [main]
6.   workflow_dispatch:
7. 
8. permissions:
9.   contents: read
10. 
11. concurrency:
12.   group: testflight-deploy
13.   cancel-in-progress: false
14. 
15. jobs:
16.   deploy:
17.     runs-on: macos-15
18.     timeout-minutes: 60
19.     steps:
20.       - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
21. 
22.       - name: Archive, sign, and upload
23.         shell: bash
24.         env:
25.           XCODE_PROJECT: ${{ vars.XCODE_PROJECT }}
26.           XCODE_SCHEME: ${{ vars.XCODE_SCHEME }}
27.           APP_BUNDLE_ID: ${{ vars.APP_BUNDLE_ID }}
28.           APPLE_TEAM_ID: ${{ vars.APPLE_TEAM_ID }}
29.           BUILD_NUMBER_OFFSET: ${{ vars.BUILD_NUMBER_OFFSET || '0' }}
30.           CERTIFICATE_BASE64: ${{ secrets.APPLE_DISTRIBUTION_CERTIFICATE_BASE64 }}
31.           CERTIFICATE_PASSWORD: ${{ secrets.APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD }}
32.           PROFILE_BASE64: ${{ secrets.APPLE_PROVISIONING_PROFILE_BASE64 }}
33.           API_KEY_BASE64: ${{ secrets.APP_STORE_CONNECT_API_KEY_BASE64 }}
34.           API_KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
35.           API_ISSUER_ID: ${{ secrets.APP_STORE_CONNECT_ISSUER_ID }}
36.         run: |
37.           set -euo pipefail
38.           for name in XCODE_PROJECT XCODE_SCHEME APP_BUNDLE_ID APPLE_TEAM_ID \
39.             CERTIFICATE_BASE64 CERTIFICATE_PASSWORD PROFILE_BASE64 API_KEY_BASE64 \
40.             API_KEY_ID API_ISSUER_ID; do
41.             if [[ -z "${!name-}" ]]; then
42.               echo "::error::Missing required variable or secret: $name"
43.               exit 1
44.             fi
45.           done
46.           if [[ ! -d "$XCODE_PROJECT" ]]; then
47.             echo "::error::XCODE_PROJECT does not point to an existing .xcodeproj."
48.             exit 1
49.           fi
50.           if [[ ! "$APP_BUNDLE_ID" =~ ^[A-Za-z0-9.-]+$ ]] ||
51.              [[ ! "$APPLE_TEAM_ID" =~ ^[A-Za-z0-9]+$ ]] ||
52.              [[ ! "$API_KEY_ID" =~ ^[A-Za-z0-9]+$ ]] ||
53.              [[ ! "$BUILD_NUMBER_OFFSET" =~ ^[0-9]{1,6}$ ]]; then
54.             echo "::error::Invalid bundle ID, team ID, API key ID, or build number offset."
55.             exit 1
56.           fi
57. 
58.           umask 077
59.           work_dir="$(mktemp -d "$RUNNER_TEMP/testflight.XXXXXX")"
60.           keychain="$work_dir/signing.keychain-db"
61.           profile_path=""
62.           api_key_path=""
63.           cleanup() {
64.             security delete-keychain "$keychain" >/dev/null 2>&1 || true
65.             [[ -z "$profile_path" ]] || rm -f "$profile_path"
66.             [[ -z "$api_key_path" ]] || rm -f "$api_key_path"
67.             rm -rf "$work_dir"
68.           }
69.           trap cleanup EXIT
70. 
71.           printf '%s' "$CERTIFICATE_BASE64" | base64 -D > "$work_dir/certificate.p12"
72.           printf '%s' "$PROFILE_BASE64" | base64 -D > "$work_dir/profile.mobileprovision"
73.           security cms -D -i "$work_dir/profile.mobileprovision" > "$work_dir/profile.plist"
74.           profile_uuid=$(/usr/libexec/PlistBuddy -c 'Print :UUID' "$work_dir/profile.plist")
75.           profile_team=$(/usr/libexec/PlistBuddy -c 'Print :TeamIdentifier:0' "$work_dir/profile.plist")
76.           if [[ ! "$profile_uuid" =~ ^[A-Fa-f0-9-]+$ ]] || [[ "$profile_team" != "$APPLE_TEAM_ID" ]]; then
77.             echo "::error::The provisioning profile UUID or team ID is invalid."
78.             exit 1
79.           fi
80.           mkdir -p "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"
81.           profile_path="$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/$profile_uuid.mobileprovision"
82.           cp "$work_dir/profile.mobileprovision" "$profile_path"
83. 
84.           keychain_password="$(openssl rand -hex 32)"
85.           security create-keychain -p "$keychain_password" "$keychain"
86.           security set-keychain-settings -lut 3600 "$keychain"
87.           security unlock-keychain -p "$keychain_password" "$keychain"
88.           security import "$work_dir/certificate.p12" -k "$keychain" -P "$CERTIFICATE_PASSWORD" -T /usr/bin/codesign
89.           security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$keychain_password" "$keychain"
90.           security list-keychains -d user -s "$keychain"
91. 
92.           build_number=$((10#$BUILD_NUMBER_OFFSET + GITHUB_RUN_NUMBER))
93.           xcodebuild -project "$XCODE_PROJECT" -scheme "$XCODE_SCHEME" \
94.             -configuration Release -destination 'generic/platform=iOS' \
95.             -archivePath "$work_dir/PodFind.xcarchive" \
96.             DEVELOPMENT_TEAM="$APPLE_TEAM_ID" CODE_SIGN_STYLE=Manual \
97.             CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER="$profile_uuid" \
98.             CURRENT_PROJECT_VERSION="$build_number" archive
99. 
100.           /usr/libexec/PlistBuddy -c 'Add :method string app-store-connect' "$work_dir/ExportOptions.plist"
101.           /usr/libexec/PlistBuddy -c "Add :teamID string $APPLE_TEAM_ID" "$work_dir/ExportOptions.plist"
102.           /usr/libexec/PlistBuddy -c 'Add :signingStyle string manual' "$work_dir/ExportOptions.plist"
103.           /usr/libexec/PlistBuddy -c 'Add :provisioningProfiles dict' "$work_dir/ExportOptions.plist"
104.           /usr/libexec/PlistBuddy -c "Add :provisioningProfiles:$APP_BUNDLE_ID string $profile_uuid" "$work_dir/ExportOptions.plist"
105.           xcodebuild -exportArchive -archivePath "$work_dir/PodFind.xcarchive" \
106.             -exportPath "$work_dir/export" -exportOptionsPlist "$work_dir/ExportOptions.plist"
107. 
108.           shopt -s nullglob
109.           ipas=("$work_dir/export/"*.ipa)
110.           if [[ ${#ipas[@]} -ne 1 ]]; then
111.             echo "::error::Expected exactly one exported IPA."
112.             exit 1
113.           fi
114.           mkdir -p "$HOME/.appstoreconnect/private_keys"
115.           api_key_path="$HOME/.appstoreconnect/private_keys/AuthKey_${API_KEY_ID}.p8"
116.           printf '%s' "$API_KEY_BASE64" | base64 -D > "$api_key_path"
117.           xcrun altool --upload-app -f "${ipas[0]}" -t ios \
118.             --apiKey "$API_KEY_ID" --apiIssuer "$API_ISSUER_ID"
119. 